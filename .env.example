# 這個檔案複製成 .env 後填入即可（.env 已在 .gitignore，不會進版控）。
# line-api/scripts/*.py 會自動往上層找 .env 並載入，不需要另外 export。

# ── 4 項 live 測試需要（GET bot/info、quota、webhook、validate/push）──
# LINE Developers Console → Messaging API channel → Messaging API 分頁
LINE_CHANNEL_ACCESS_TOKEN=

# ── 再多 1 項：stateless token（POST /oauth2/v3/token）──
# Console → Basic settings
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# ── 再多 1 項：channel access token v2.1（POST /oauth2/v2.1/token）──
# 驗證本專案純 Python 實作的 RS256 JWT 能被 LINE 伺服器接受。
# 私鑰是 Console → Basic settings → Assertion Signing Key 產生的那對金鑰的私鑰（JWK 檔）。
# 產生方式：python tools/make_assertion_key.py
# 它會印出公鑰 JWK，貼進 Console → Register 之後把 kid 填在下面
LINE_ASSERTION_PRIVATE_KEY=
LINE_ASSERTION_KID=

# ── LIFF 範例用（examples/liff/index.html）──
LIFF_ID=

# ---------------------------------------------------------------------------
# LINE Login channel（LIFF app 所屬的那個，不是 Messaging API channel）
# 解鎖：live 的 ID token 驗證——自己驗簽的結果與 LINE 的 verify 端點對答案
#
# 取得方式：Console 選 LINE Login channel →
#   1. Basic settings → OpenID Connect → Apply（沒開就不會回 id_token）
#   2. LINE Login → Callback URL 加 http://localhost:8765/callback
#   3. python tools/get_id_token.py
# ---------------------------------------------------------------------------
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# 由 tools/get_id_token.py 自動寫入，效期很短，過期就重跑
LINE_ID_TOKEN=
